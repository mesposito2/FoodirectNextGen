<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish used by CI (.github/workflows/ci-cd.yml) and locally:
    msbuild UI\UI.csproj /p:Configuration=Release /p:DeployOnBuild=true /p:PublishProfile=CI-Folder /p:PublishUrl=<output dir>
  Applies Web.Release.config. The output folder is what gets zipped and deployed to Azure App Service.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <PublishUrl Condition="'$(PublishUrl)' == ''">$(MSBuildProjectDirectory)\..\artifacts\publish</PublishUrl>
    <DeleteExistingFiles>True</DeleteExistingFiles>
  </PropertyGroup>
</Project>
