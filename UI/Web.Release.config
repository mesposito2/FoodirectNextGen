<?xml version="1.0"?>

<!-- For more information on using web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    In the example below, the "SetAttributes" transform will change the value of 
    "connectionString" to use "ReleaseSQLServer" only when the "Match" locator 
    finds an atrribute "name" that has a value of "MyDB".
    
    <connectionStrings>
      <add name="MyDB" 
        connectionString="Data Source=ReleaseSQLServer;Initial Catalog=MyReleaseDB;Integrated Security=True" 
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
    </connectionStrings>
  -->
  <appSettings xdt:Transform="Replace">

    <!-- Must match the System.Web.WebPages version in bin (3.0); 2.0.0.0 crashes the app at startup. -->
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="true"/>
    <add key="PreserveLoginUrl" value="true"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!-- values that shoyld be replaced-->
    <add key="ADUPLOADPATH" value="/mounts/fddatashare/Foodirect/AdUpload"/>
    <add key="ADUPLOADWEBPATH" value="\AdUpload"/>
    <add key="LOGPATH" value="/mounts/fddatashare/Foodirect/JobLogs"/>
    <add key="EMAILPATH" value="/mounts/fddatashare/Foodirect/EmailTemplates"/>
    <add key="EMAILON" value="true"/>
    <add key="ENFORCESSL" value="false"/>
    <add key="TEMPEXPORTPATH" value="/mounts/fddatashare/Foodirect/TempExport"/>
    <add key="APPSERVERLOGPATH" value="/mounts/fddatashare/Foodirect/JobLogs"/>
    <!-- this would be the broad site URL from oustide the fireall-->
    <add key="SITEURL" value="https://foodirect.quasarsolutions.com"/>
    <add key="BOOKURL" value="https://foodirect.quasarsolutions.com/ProductBook"/>
    <!-- this is the local URL from within the firewall -->
    <add key="LOCALURL" value="172.212.225.116/" />
  
    <add key="AS400_EOW_SQL_GET" value="select DSCFLG1  from DSFDID10_MDCTCNTL where DSCKey=3"/>
    <add key="AS400_EOW_SQL_SET" value="update DSFDID10_MDCTCNTL set DSCFLG1='{0}' where DSCKey=3"/>
    <add key="AS400APIURI" value="https://foodirect.quasarsolutions.com/XAPI/AS400/"/>
    <add key="AS400APIWHITELIST" value="172.212.225.116,::1"/>
    <add key="AS400_INV_SQL" value="select pieces,nexdat,prodcd from Inventory where prodcd in ({0})"/>
    <!-- end enviornment file settings -->
    <add key="WEBPONUMSTART" value="200000"/>
    <add key="REALINVENTORYFETCH" value="true"/>
    <add key="CANORDER" value="true"/>
    <add key="BUSINESSEMAIL" value="sales@foodirect.com"/>
    <add key="WEBMASTEREMAIL" value="mike@espositogroup.com"/>
    <add key="SMTPSERVER" value="smtp.sendgrid.net"/>
    <add key="SMTPPORT" value="25"/>
    <add key="SMTPUSER" value="apikey"/>
    <!-- SECRETS: left blank on purpose. Azure App Service "Application settings" with the same
         names override these at runtime: SMTPPWD, EXPERTPDF, RECAPTCHA_SECRET, FD_ENCRYPTION_KEY -->
    <add key="SMTPPWD" value=""/>
    <add key="RECAPTCHA_SECRET" value=""/>
    <add key="FD_ENCRYPTION_KEY" value=""/>
    <add key="LOGIN_COOKIE_KEY" value=""/>
    <add key="MAINT_PAGE" value="/default.html"/>
    <add key="INSTANCENAME" value="AZURE PREPROD"/>
    <!-- PDF Info  -->
    <add key="AUTHORNAME" value="Foodirect, Inc."/>
    <add key="APPLICATION" value="Foodirect.com"/>
    <!-- ExpertPDF v15 license key: App Service setting EXPERTPDF -->
    <add key="EXPERTPDF" value=""/>
    <!-- Order Cut Off Info -->
    <add key="ORDERCUTOFF" value="15:30"/>
    <add key="PRODUCECUTOFF" value="14:30"/>
    <add key="PRODUCECATID" value="13"/>
    <!-- Only read 1000 Invnetory items at a time from the 4000 -->
    <add key="AS400_INV_BATCH" value="1000"/>
  </appSettings>

  <!-- Connection strings contain credentials, so the real values are NOT here. Configure them in
       Azure App Service > Configuration > Connection strings using the SAME names (FD = type SQLAzure,
       FDAS400_* = type Custom); App Service overrides these placeholders at runtime. -->
  <connectionStrings xdt:Transform="Replace">
    <add name="FD" connectionString="Set-in-Azure-App-Service-connection-strings" providerName="System.Data.SqlClient"/>
    <add name="FDAS400_PRIMARY"   connectionString="Set-in-Azure-App-Service-connection-strings" providerName="System.Data.OdbcClient" />
    <add name="FDAS400_SECONDARY" connectionString="Set-in-Azure-App-Service-connection-strings" providerName="System.Data.OdbcClient" />
    <add name="FDAS400_TERTIARY"  connectionString="Set-in-Azure-App-Service-connection-strings" providerName="System.Data.OdbcClient" />
  </connectionStrings>

  <system.web>
    <!-- Production must not run with debug compilation (slower, larger memory, no batch compile). -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!--
      In the example below, the "Replace" transform will replace the entire 
      <customErrors> section of your web.config file.
      Note that because there is only one customErrors section under the 
      <system.web> node, there is no need to use the "xdt:Locator" attribute.
      
      <customErrors defaultRedirect="GenericError.htm"
        mode="RemoteOnly" xdt:Transform="Replace">
        <error statusCode="500" redirect="InternalError.htm"/>
      </customErrors>
    -->
  </system.web>
</configuration>