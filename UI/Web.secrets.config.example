<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to Web.secrets.config (same folder) and fill in. Web.secrets.config is ignored by Git.
     In Azure, set the same keys as App Service "Application settings" instead. -->
<appSettings>
  <add key="SMTPPWD" value="&lt;SendGrid API key&gt;"/>
  <add key="EXPERTPDF" value="&lt;ExpertPDF v15 license key&gt;"/>
  <add key="RECAPTCHA_SECRET" value="&lt;Google reCAPTCHA v2 secret&gt;"/>
  <!-- Needed unless FDShared\SecurityCore.Fallback.cs exists locally. Must match the key that encrypted existing data. -->
  <add key="FD_ENCRYPTION_KEY" value="&lt;legacy AES key&gt;"/>
  <!-- Needed unless UI\Objects\CookieHelper.Fallback.cs exists locally. Remember-me cookie key. -->
  <add key="LOGIN_COOKIE_KEY" value="&lt;legacy cookie key&gt;"/>
</appSettings>
