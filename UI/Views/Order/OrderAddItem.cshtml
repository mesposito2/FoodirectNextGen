@model UI.MODELS.OrderAddItemModel
@{
    ViewBag.Title = "Add " + Model.Description;
    Layout = Request.IsAjaxRequest() ? null : "~/Views/Shared/_LayoutPopup.cshtml";
}
<form id="frmORDERADDITEM" class="stack" style="--gap:16px" data-line data-code="@Model.ProductCode">
    @Html.HiddenFor(m => m.ProductCode)
    <div>
        <span class="sp-code">#@Model.ProductCode</span>
        <h3 class="mt-1 mb-0">@Model.Description</h3>
    </div>
    <div class="form-grid">
        <div class="field">
            @Html.LabelFor(m => m.QTY)
            <input class="js-qty" type="number" id="QTY" name="QTY" value="@(Model.QTY > 0 ? Model.QTY : 1)" min="1" step="1">
        </div>
        <div class="field">
            @Html.LabelFor(m => m.UOM)
            @if (Model.CaseCount > 1)
            {
                <select class="js-uom" id="UOM" name="UOM"><option>CS</option><option>PC</option></select>
            }
            else
            {
                <input type="text" value="CS" readonly class="js-uom" name="UOM">
            }
        </div>
    </div>
    @if (!string.IsNullOrEmpty(Model.InventoryInfo))
    {
        <div class="alert alert-err"><i class="fa-solid fa-boxes-stacked"></i><div><strong>@Html.DisplayNameFor(m => m.InventoryInfo):</strong> @Model.InventoryInfo</div></div>
    }
    <div class="form-actions"><button class="btn" type="button" data-add-to-order><i class="fa-solid fa-cart-plus"></i> Add item</button></div>
</form>
