@model UI.MODELS.PersonModel
@{
    ViewBag.Title = "Customer credit application";
    ViewBag.Crumb = "Customers";
    ViewBag.Lede = "Apply for customer credit with Foodirect.";
}
<div class="container container-narrow page-body">
    <div class="card card-body tile">
        <div class="tile-icon"><i class="fa-solid fa-file-signature"></i></div>
        <div>
            <h3>Foodirect customer credit application</h3>
            <p class="mb-2">Use the secure online application below to apply for customer credit.</p>
            <a class="btn" href="https://app.anansii.com/onboarding/foodirect?action=new" target="_blank" rel="noopener">Open credit application <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
    </div>
</div>
