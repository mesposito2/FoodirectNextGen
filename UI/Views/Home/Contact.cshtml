@{
    ViewBag.Title = "Contact & directions";
    ViewBag.Crumb = "Get in touch";
    ViewBag.Lede = "Visit us in the Hunts Point Cooperative Market, call, or send us a message.";
    ViewBag.HeroImage = "~/MySkin/MyStuff/INDEX_WAREHOUSE.jpg";
}
@section HeadXContent {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
<div class="container page-body">
    <div class="grid grid-2" style="--gap:28px">
        <div class="stack" style="--gap:20px">
            <div class="grid grid-2">
                <div class="card tile"><div class="tile-icon"><i class="fa-solid fa-location-dot"></i></div><div><h3>Visit</h3><p>Hunts Point Cooperative Market<br>355 Food Center Dr, Unit C-6<br>Bronx, NY 10474</p></div></div>
                <div class="card tile is-accent"><div class="tile-icon"><i class="fa-solid fa-phone"></i></div><div><h3>Call</h3><p><a href="tel:17185892300" class="fw-600">718.589.2300</a><br>Ask for Jason Levine</p></div></div>
            </div>
            <div class="card">
                <div class="card-head"><h2>Email us</h2></div>
                <div class="card-body">
                    @using (Html.BeginForm("Contact", "Home", FormMethod.Post, new { id = "frmCONTACT", @class = "stack", style = "--gap:16px" }))
                    {
                        <div class="field">
                            <label for="Email">Your email</label>
                            <input type="email" id="Email" name="Email" placeholder="name@example.com" required maxlength="200" autocomplete="email">
                        </div>
                        <div class="field">
                            <label for="Message">Message</label>
                            <textarea id="Message" name="Message" required rows="6" placeholder="How can we help?"></textarea>
                        </div>
                        <div class="g-recaptcha" data-sitekey="6LckT6cUAAAAAJqVc_JDv51-Vs25zx6UsblIkBEI"></div>
                        <div class="form-actions"><button class="btn" type="submit"><i class="fa-solid fa-paper-plane"></i> Send message</button></div>
                    }
                </div>
            </div>
        </div>
        <iframe class="map-frame" title="Map to Foodirect" loading="lazy" style="height:100%;min-height:420px;aspect-ratio:auto"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1509.9920533561833!2d-73.87464534320166!3d40.8063430397753!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c2f510ee84d47f%3A0xd5210114ef4d8a92!2sFoodirect%2CInc.!5e0!3m2!1sen!2sus!4v1472032236035" allowfullscreen></iframe>
    </div>
</div>
