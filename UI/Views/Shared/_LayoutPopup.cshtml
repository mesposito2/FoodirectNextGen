<!DOCTYPE html>
@{
    var skinCookie = Request.Cookies["fd-skin"];
    var skin = skinCookie == null ? "classic" : skinCookie.Value;
    if (skin != "midnight" && skin != "market" && skin != "nordic" && skin != "deco" && skin != "neon") { skin = "classic"; }
}
<html lang="en" @(skin == "classic" ? null : Html.Raw("data-skin=\"" + skin + "\""))>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title · Foodirect</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&family=Limelight&family=Josefin+Sans:wght@600;700&family=Monoton&family=Audiowide&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/lib/fontawesome/6.5.2/css/all.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/fd/fd.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/fd/fd-skins.css")" rel="stylesheet">
    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/Content/fd/fd.js")"></script>
    @RenderSection("HeadXContent", required: false)
</head>
<body style="background:var(--fd-surface)">
    <div style="padding:20px;max-width:760px;margin:0 auto">
        @Html.Partial("_DisplayMsg")
        @RenderBody()
    </div>
    @RenderSection("FootXContent", required: false)
</body>
</html>
