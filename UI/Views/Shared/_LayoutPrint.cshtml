<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    @* Print/PDF layout: absolute URLs because ExpertPDF fetches this page server-side. *@
    <link href="http://@UI.OBJECTS.Config.LOCALURL/Content/MySite.css" rel="stylesheet" type="text/css">
    <link href="http://@UI.OBJECTS.Config.LOCALURL/Content/fd/fd-print.css" rel="stylesheet" type="text/css">
    <script src="http://@UI.OBJECTS.Config.LOCALURL/Scripts/jquery-3.7.1.min.js"></script>
    @RenderSection("HeadXContent", required: false)
    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () { (i[r].q = i[r].q || []).push(arguments) }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');
        ga('create', 'UA-86507437-1', 'auto');
        ga('send', 'pageview');
    </script>
</head>
<body class="fd-print">
    @RenderBody()
</body>
</html>
