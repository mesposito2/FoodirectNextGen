@model UI.MODELS.BookConfigModel
@{
    ViewBag.Title = "Book generation settings";
    ViewBag.Crumb = "Administration · Product book";
    ViewBag.HeroCompact = true;
}
@section FootXContent {
    <script>
        function deleteAd(id) {
            if (!confirm("Are you sure you wish to delete this ad?")) return;
            document.getElementById("MODE").value = "DEL";
            document.getElementById("DELID").value = id;
            document.getElementById("frmSAVE").submit();
        }
    </script>
}
<div class="container page-body">
    @using (Html.BeginForm("BookGenSave", "Admin", FormMethod.Post, new { id = "frmSAVE", @class = "stack", style = "--gap:22px" }))
    {
        <input type="hidden" name="BookConfigID" value="@Model.BookConfigID">
        <input type="hidden" name="MODE" id="MODE" value="SAVE">
        <input type="hidden" name="DELID" id="DELID" value="0">

        <div class="card">
            <div class="card-head"><h2>General settings</h2><a class="btn btn-sm btn-ghost" href="/admin/PersonsBookRedirect?custid=FOODD" target="_blank">Test with Foodirect's HTML book <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>
            <div class="card-body">
                <label class="check"><input type="checkbox" @(Model.ShowPrices ? "checked" : "") name="ShowPrices"> Show prices in the product book</label>
                <p class="text-muted text-sm mt-1 mb-0">Save settings before testing.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h2>Ads &amp; pages</h2>@Html.ActionLink("Upload new ad images", "ManageAd", "Admin", null, new { @class = "btn btn-sm btn-secondary" })</div>
            <p class="text-muted text-sm" style="padding:12px 24px 0;margin:0">Only one ad per page. Duplicate page numbers will be moved to an open page.</p>
            <div style="padding:14px">
                <div class="table-wrap" style="box-shadow:none">
                    <table class="data-table">
                        <thead><tr><th style="width:70px">ID</th><th>Ad</th><th style="width:160px">Book page</th><th style="width:70px"></th></tr></thead>
                        <tbody>
                            @if (Model.AdList != null)
                            {
                                foreach (var o in Model.AdList)
                                {
                                    <tr>
                                        <td class="text-muted">@o.BookConfigAdID</td>
                                        <td>
                                            <input type="hidden" name="ID_@o.BookConfigAdID" value="@o.BookConfigAdID">
                                            <select class="input input-sm" name="AD_SELECT_@o.BookConfigAdID">
                                                @foreach (var a in Model.Ads)
                                                {
                                                    <option value="@a.Value" @(a.Value == o.AdID.ToString() ? "selected" : "")>@a.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="input input-sm" type="number" min="1" name="PAGE_@o.BookConfigAdID" value="@o.PageNum"></td>
                                        <td><button type="button" class="icon-action is-danger" title="Delete ad from book generation" onclick="deleteAd(@o.BookConfigAdID)"><i class="fa-solid fa-trash-can"></i></button></td>
                                    </tr>
                                }
                            }
                            <tr class="row-new">
                                <td><span class="badge badge-green">New</span></td>
                                <td>
                                    <input type="hidden" name="ID_0" value="0">
                                    @if (Model.Ads != null)
                                    {
                                        <select class="input input-sm" name="AD_SELECT_0" id="AD_SELECT_0">
                                            <option value="0">— Select an ad —</option>
                                            @foreach (var a in Model.Ads) { <option value="@a.Value">@a.Name</option> }
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No ads defined yet. @Html.ActionLink("Create ads here", "ManageAd", "Admin").</span>
                                    }
                                </td>
                                <td><input class="input input-sm" type="number" min="1" name="PAGE_0" id="PAGE_0" placeholder="Page #"></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div><button type="submit" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save settings</button></div>
    }
</div>
