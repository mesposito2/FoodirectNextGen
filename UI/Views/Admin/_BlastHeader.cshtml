@model UI.MODELS.MarketingEmailBlastModel
@{
    int step = (int)(ViewData["Step"] ?? 1);
    string to = Model.ToUCODE == "CUSTOM" ? Model.ToOther : Model.ToUCODE == "ALL" ? "All members" : Model.ToUCODE == "NONEU" ? "Jobbers and wholesalers" : Model.ToUCODE == "EU" ? "End users" : "";
    Func<int, string> cls = n => n < step ? "is-done" : n == step ? "is-current" : "";
}
<div class="card card-body stack" style="--gap:18px">
    @if (step > 0)
    {
        <ol class="stepper" aria-label="Email blast steps">
            <li class="@cls(1)">Compose</li>
            <li class="@cls(2)">Attachments</li>
            <li class="@cls(3)">Review &amp; send</li>
        </ol>
    }
    <dl class="kv">
        <dt>Blast ID</dt><dd>@(Model.EmailBlastID == 0 ? "New" : Model.EmailBlastID.ToString())</dd>
        @if (Model.EmailBlastID != 0)
        {
            <dt>Created</dt><dd>@Model.CreatedByDate.ToLongDateString() — @Model.CreatedBy</dd>
            <dt>Status</dt><dd><span class="badge">@Model.StatusUCODE</span></dd>
        }
        @if (step > 1 || step == 0)
        {
            <dt>To</dt><dd>@to</dd>
            <dt>Subject</dt><dd class="fw-600">@Model.Subject</dd>
        }
    </dl>
</div>
