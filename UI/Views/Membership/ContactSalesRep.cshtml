@model UI.MODELS.SalesMessageModel
@{
    ViewBag.Title = "Contact your sales rep";
    ViewBag.HeroCompact = true;
}
@section HeadXContent { @Html.Partial("_Validation") }
<div class="container container-narrow page-body">
    <div class="card">
        <div class="card-head"><h2>Send a message to <span class="text-green">@ViewBag.SalesManName</span></h2></div>
        <div class="card-body">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "stack", style = "--gap:16px" }))
            {
                @Html.ValidationSummary(true)
                <div class="field">
                    @Html.LabelFor(m => m.Message)
                    @Html.TextAreaFor(m => m.Message, new { rows = "7" })
                    @Html.ValidationMessageFor(m => m.Message)
                </div>
                <div class="form-actions"><button class="btn" type="submit"><i class="fa-solid fa-paper-plane"></i> Send</button><a class="btn btn-ghost" href="/Membership/Dashboard">Cancel</a></div>
            }
        </div>
    </div>
</div>
