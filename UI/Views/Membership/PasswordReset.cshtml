@model UI.MODELS.PasswordResetModel
@{
    ViewBag.Title = "Password help";
    ViewBag.HideHero = true;
}
@section HeadXContent { @Html.Partial("_Validation") }

<div class="auth">
    <div class="auth-visual" style="--auth-img:url('@Url.Content("~/MySkin/MyStuff/CAT_Deli.jpg")')">
        <div class="q"><h2>Locked out?</h2><p>Enter your Internet ID and we'll help you get back in.</p></div>
    </div>
    <div class="auth-form">
        <div class="inner">
            <h1>Password help</h1>
            <p class="sub">We'll send your account help to the email on file.</p>
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "stack", style = "--gap:18px" }))
            {
                @Html.ValidationSummary(true)
                <div class="field">
                    @Html.LabelFor(m => m.UserName)
                    @Html.TextBoxFor(m => m.UserName, new { autocomplete = "username", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.UserName)
                </div>
                <button class="btn btn-lg btn-block" type="submit">Get help</button>
                <p class="text-center text-sm mb-0"><a href="@Url.Action("Login")"><i class="fa-solid fa-arrow-left"></i> Back to log in</a></p>
            }
        </div>
    </div>
</div>
