@model UI.MODELS.LoginModel
@{
    ViewBag.Title = "Log in";
    ViewBag.HideHero = true;
}
@section HeadXContent { @Html.Partial("_Validation") }

<div class="auth">
    <div class="auth-visual">
        <div class="q">
            <span class="eyebrow" style="color:var(--fd-on-dark-soft)">Customer portal</span>
            <h2>Your warehouse,<br>open 24/7 online.</h2>
            <p>Check real-time availability, build orders from your speed list, and track every delivery.</p>
        </div>
    </div>
    <div class="auth-form">
        <div class="inner">
            <h1>Welcome back</h1>
            <p class="sub">Log in with your Foodirect Internet ID.</p>
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "stack", style = "--gap:18px" }))
            {
                @Html.ValidationSummary(true)
                <div class="field">
                    @Html.LabelFor(m => m.UserName)
                    @Html.TextBoxFor(m => m.UserName, new { autocomplete = "username", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.UserName)
                </div>
                <div class="field">
                    <div class="spread">@Html.LabelFor(m => m.Password)<a class="text-sm" href="@Url.Action("PasswordReset")">Password trouble?</a></div>
                    @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password)
                </div>
                <label class="check">@Html.CheckBoxFor(m => m.RememberMe) @Html.DisplayNameFor(m => m.RememberMe)</label>
                <button class="btn btn-lg btn-block" type="submit">Log in <i class="fa-solid fa-arrow-right"></i></button>
                <p class="text-center text-muted text-sm mb-0">New to Foodirect? <a href="@Url.Action("Register")">Become a customer</a></p>
            }
        </div>
    </div>
</div>
